# =============================================================================
# Configuration for deploy.sh.
#
#   cp config.env.example config.env      # then edit config.env
#   chmod 600 config.env
#   ./deploy.sh
#
# deploy.sh runs this file as shell. It refuses a file that belongs to another
# user or that every user may write to, and warns when others can read it.
#
# Anything still starting with YOUR_ makes the script stop before it changes
# anything. No setting may hold a line break or another control character.
#
# Secrets are better given in your shell than written here. Type them so that
# they do not land in the shell's history file, for example:
#
#   read -rs LOOKER_LICENSE_KEY && export LOOKER_LICENSE_KEY
#                                        # only to build the Looker image and
#                                        # license a brand-new instance
#   read -rs LOOKER_CLIENT_SECRET && export LOOKER_CLIENT_SECRET
#                                        # Looker API credentials for the agent
#   read -rs ANTHROPIC_API_KEY && export ANTHROPIC_API_KEY
#                                        # only for AGENT_MODEL_PROVIDER=anthropic
#
# deploy.sh does not pass them on to the tools it starts (kubectl, docker, go,
# git, npm).
# =============================================================================

# --- How strict -----------------------------------------------------------------
# Some settings below work but are weaker than they could be: an image named by
# tag, a connection without TLS, a switch that turns a protection off.
#   "standard" = go ahead, and list every such setting after validation.
#   "strict"   = refuse to run while there is one, and name them all.
# With every default as it is, "strict" refuses an on-prem configuration: the
# list it prints says what to set.
SECURITY_MODE="standard"

# --- Where it runs ------------------------------------------------------------
# "onprem" = a Kubernetes cluster outside Google Cloud that you already have.
# "gke"    = Google Kubernetes Engine. The script creates the cluster.
PLATFORM="onprem"

# kubectl context of the target cluster.
#   onprem: required.
#   gke:    leave empty. The script creates the cluster and uses its own
#           kubeconfig under the work directory.
KUBE_CONTEXT="YOUR_KUBECTL_CONTEXT"

# --- Container registry -------------------------------------------------------
# Both images (Looker and the agent) are pushed under this path.
#   onprem: for example registry.corp.example/looker-agent. The cluster must be
#           able to pull the AGENT image from it WITHOUT credentials. Substrate
#           pulls actor images itself and, in the install profile used outside
#           Google Cloud, has no registry login. See README, "On-prem limits".
#   gke:    REGION-docker.pkg.dev/PROJECT/REPOSITORY. Created if it is missing.
REGISTRY="YOUR_REGISTRY_PATH"
# Target platform for container builds. Building Looker from looker/Dockerfile
# requires linux/amd64 (Google Chrome's Linux repository is amd64-only); supply
# a pre-built LOOKER_IMAGE if your cluster runs another architecture.
IMAGE_PLATFORM="linux/amd64"

# --- Namespaces and the network between them -----------------------------------
# The kit uses four namespaces, each with its own Pod Security level. They must
# be four different ones, and none may belong to the cluster or to Substrate.
#   LOOKER_NAMESPACE   Looker and its database        enforces "baseline"
#   AGENT_NAMESPACE    Substrate's sandbox workers    has to allow "privileged"
#   GATEWAY_NAMESPACE  the gateway                    enforces "restricted"
#   CREDS_NAMESPACE    the model credential           enforces "restricted"
# The gateway holds both passwords and the certificate Substrate's router
# admits. That is why it does not share a namespace with the workers: whoever
# may create a pod in the workers' namespace may create a privileged one.
LOOKER_NAMESPACE="looker"
AGENT_NAMESPACE="looker-agent"
GATEWAY_NAMESPACE="looker-agent-gateway"
CREDS_NAMESPACE="looker-agent-creds"

# "true" = the script applies NetworkPolicies to its namespaces, except the
# workers' (Substrate keeps its own policy there): nothing gets in or out
# unless a rule allows it. They only act on a cluster whose network plugin
# enforces NetworkPolicy. "false" is for clusters where another team owns the
# policies.
NETWORK_POLICIES="true"
# "true" = preflight creates a temporary restricted namespace with a deny-all
# NetworkPolicy and confirms a blocked connection really fails before installing
# anything. Uses GATEWAY_IMAGE (Python). Not tested against a live cluster.
NETWORK_POLICY_CHECK="true"
# Comma-separated TCP ports where your cluster's Kubernetes API server endpoints
# listen (post-DNAT). Allowed from vertex-token-refresher alongside 443.
KUBE_API_PORTS="443,6443"
# The namespace of your ingress controller. Its pods may reach Looker or the
# gateway when the matching Ingress below is enabled, and not otherwise.
# Rendered Ingress annotations target ingress-nginx; adjust rendered manifests
# if you use another ingress controller.
INGRESS_CONTROLLER_NAMESPACE="ingress-nginx"

# --- Looker (customer-hosted) -------------------------------------------------
# Separate registry and pull secret for the licensed Looker image. Empty
# LOOKER_REGISTRY uses REGISTRY above; setting another path keeps the Looker
# image out of a repository that must allow unauthenticated pulls for the agent
# image. LOOKER_IMAGE_PULL_SECRET names a docker-registry Secret in LOOKER_NAMESPACE.
LOOKER_REGISTRY=""
LOOKER_IMAGE_PULL_SECRET=""

# "true"  = build and deploy Looker on this cluster.
# "false" = Looker already runs somewhere. Set LOOKER_API_URL below.
DEPLOY_LOOKER="true"

# Hostname people type into a browser to reach Looker. Links in the agent's
# answers carry it, and it is the Looker "host URL".
LOOKER_HOST="YOUR_LOOKER_HOSTNAME"

# Looker release to download and build, as major.minor (for example 26.6).
# The bundled MySQL below is version 8.4, which Looker supports from 26.6: with
# an older Looker, give it a database of your own (LOOKER_DB_HOST).
# Releases before 26.4 need LOOKER_JAVA_PACKAGE="openjdk-17-jdk-headless".
LOOKER_VERSION="YOUR_LOOKER_VERSION"
LOOKER_JAVA_PACKAGE="openjdk-21-jdk-headless"
# Email Looker's download service registers for this license, and the first
# admin account created on a brand-new instance.
LOOKER_TECHNICAL_CONTACT_EMAIL="YOUR_EMAIL"
LOOKER_ADMIN_EMAIL="YOUR_EMAIL"
# Use an image you already have instead of building one (skips the download).
LOOKER_IMAGE=""
# Base image for looker/Dockerfile when building Looker. Pin by @sha256: digest
# for SECURITY_MODE="strict".
LOOKER_BASE_IMAGE="ubuntu:24.04"

LOOKER_REPLICAS="1"                 # more than 1 needs a ReadWriteMany storage class (on GKE, setup-gcp disables Filestore CSI)
LOOKER_STORAGE_CLASS=""             # empty = the cluster's default storage class
LOOKER_STORAGE_SIZE="50Gi"
LOOKER_CPU_REQUEST="2"
LOOKER_MEMORY="8Gi"
LOOKER_HEAP_PERCENT="60"            # JVM heap share of LOOKER_MEMORY (10-90)
# What Looker may write outside its volumes before the node evicts the pod.
LOOKER_EPHEMERAL_STORAGE_LIMIT="20Gi"
# Extra options for "looker.jar start". Letters, digits, spaces and
# = _ . , : / @ + - only: the value is read by a shell inside the Looker pod.
LOOKER_STARTUP_FLAGS=""

# Looker renders dashboards with Chromium, and Chromium isolates its pages in a
# sandbox of its own that needs to create user namespaces. The "RuntimeDefault"
# seccomp profile forbids that. So by default the Looker container names no
# seccomp profile and runs under whatever the cluster's default is. Two ways to
# run it under a profile:
#   LOOKER_SECCOMP_PROFILE="RuntimeDefault" together with
#   LOOKER_CHROMIUM_NO_SANDBOX="true", which builds the Looker image with a
#   "chromium" command that passes --no-sandbox so Chromium gives up its own
#   sandbox and the container's profile is what confines it. Also the way out
#   on nodes that do not allow unprivileged user namespaces at all.
# "Unconfined" is accepted too, but Looker's namespace then has to allow
# privileged pods. None of this could be tried without a cluster.
LOOKER_SECCOMP_PROFILE=""
LOOKER_CHROMIUM_NO_SANDBOX="false"

# "true" = add an init container that hands the shared-files volume to Looker's
# user. Only for NFS exports that ignore fsGroup. It is the one container of
# the kit that runs as root; it holds a single capability (CHOWN).
LOOKER_CHOWN_SHARED_FILES="false"

# What Looker itself may open connections to, besides its own database and the
# gateway: the databases it queries, Git, mail, Looker's license service.
# Comma-separated CIDRs, for example "10.20.0.0/16,192.0.2.10/32".
# "0.0.0.0/0" means anywhere, pods of this cluster included.
LOOKER_EGRESS_CIDRS="0.0.0.0/0"

# Looker's own database. Empty LOOKER_DB_HOST deploys MySQL 8.4 in the cluster,
# which is fine for a trial and not for production: no backups, no failover.
LOOKER_DB_HOST=""
LOOKER_MYSQL_STORAGE_CLASS=""       # bundled MySQL only; empty = the default storage class
LOOKER_DB_PORT="3306"
LOOKER_DB_NAME="looker"
LOOKER_DB_USER="looker"
# LOOKER_DB_PASSWORD: export it when LOOKER_DB_HOST is set. Written to a
# mounted looker-db.yml Secret (any non-control characters are accepted).
# "true" = Looker's connection to its database uses TLS, and the bundled MySQL
# accepts nothing else over the network.
LOOKER_DB_SSL="true"
# Verify the MySQL server certificate in looker-db.yml ("true", "false", or
# empty: defaults to "false" for bundled MySQL's self-signed certificate and
# "true" for an external LOOKER_DB_HOST).
LOOKER_DB_VERIFY_SSL=""

# Optional Ingress for the Looker UI. The annotations target ingress-nginx.
# An Ingress needs its certificate: LOOKER_TLS_SECRET is required with it.
LOOKER_INGRESS_ENABLED="false"
LOOKER_INGRESS_CLASS="nginx"
LOOKER_TLS_SECRET=""                # kubernetes.io/tls Secret in LOOKER_NAMESPACE

# --- How the agent reaches the Looker API --------------------------------------
# Leave LOOKER_API_URL empty when DEPLOY_LOOKER="true": the in-cluster API
# service is used. Otherwise give the API base URL. It must use a DNS name, not
# an IP address: Substrate's egress rules match names only.
LOOKER_API_URL=""
# Looker's built-in certificate is self-signed, so verification is off for the
# in-cluster default. Set "true" when LOOKER_API_URL presents a certificate the
# agent can verify. For a private CA, also set EXTRA_CA_FILE.
LOOKER_VERIFY_SSL=""
EXTRA_CA_FILE=""
# API credentials, created in Looker under Admin > Users > Edit > API keys.
# They do not exist until Looker is running, so the first run stops after
# deploying Looker and Substrate and tells you to come back with them.
LOOKER_CLIENT_ID="YOUR_LOOKER_CLIENT_ID"
# LOOKER_CLIENT_SECRET: export it in your shell.
# The LookML model(s) the agent's tools may use, as a JSON list. Nothing
# outside the list is queried.
LOOKER_MODELS='["thelook"]'
# What a link in an answer is.
#   "plain"  = the ordinary address of the dashboard or Look. It opens with the
#              reader's own Looker session.
#   "signed" = a signed embed link. Whoever holds one gets a Looker session of
#              its own, so treat this as handing out credentials. It also needs
#              "Embed SSO Authentication" switched on in Looker.
LOOKER_LINK_MODE="plain"

# --- Reasoning model ----------------------------------------------------------
# Same choices as the Agent Engine script:
#   "claude"        Claude on Vertex AI through LiteLlm
#   "claude_native" Claude on Vertex AI through ADK's own Claude class
#   "gemini"        Gemini on Vertex AI
#   "anthropic"     Claude through the Anthropic API (needs ANTHROPIC_API_KEY)
AGENT_MODEL_PROVIDER="claude"
CLAUDE_MODEL="claude-sonnet-4-6"
CLAUDE_LOCATION="us-east5"          # Vertex region that serves the Claude model
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_LOCATION="us-central1"
# Google Cloud project billed for Vertex AI. Needed for every provider except
# "anthropic", and always on GKE.
GCP_PROJECT_ID="YOUR_GOOGLE_CLOUD_PROJECT_ID"
# onprem + Vertex only: key file of a service account allowed aiplatform.endpoints.predict.
# It is stored in a Secret outside the agent's sandbox and used to mint the
# short-lived tokens the egress gateway injects. Not needed on GKE, which uses
# Workload Identity instead.
GCP_SA_KEY_FILE=""
# "true" = the agent also serves ADK's developer UI and its extra endpoints
# (everyone's sessions, traces, evaluations), behind the administrator's
# password. The chat needs none of it.
AGENT_DEV_UI="false"

# --- Agent Substrate ----------------------------------------------------------
# onprem only. Substrate has no supported install outside GKE, so this kit runs
# the installer's local-development profile on your cluster. README.md, "Four
# things that change the plan", says what that installs. Set to "true" once you
# have read it and want to go ahead.
ONPREM_DEV_PROFILE_ACCEPTED="false"

SUBSTRATE_VERSION="v1.0.0"
# The commit that tag has to be. The script checks out the tag, and then builds
# and runs what it got on this machine, with your cluster credentials; a tag
# can be moved, a commit id cannot. When the checkout is another commit it is
# removed and nothing runs. Empty switches the check off.
SUBSTRATE_COMMIT="b34fbee742906494b5eb4f1f36987176bf8770a4"
SUBSTRATE_IMAGE_REPO="ghcr.io/agent-substrate/substrate"
# The image of the sandbox worker pods. Empty = the one of SUBSTRATE_VERSION,
# named by tag. To pin it, give it as name:tag@sha256:<digest>.
WORKER_IMAGE=""

# Substrate's router admits clients by a list of identities, and has no finer
# rule: whoever is on the list reaches every actor. The gateway is on it.
# "true" adds a second identity (ate-system/atenet-client), which lets an
# administrator use "kubectl ate proxy actor" for debugging, around the gateway
# and its passwords. Takes effect when Substrate is installed (or installed
# again with SUBSTRATE_FORCE_DEPLOY="true").
ALLOW_KUBECTL_ATE_PROXY="false"

# onprem only: where actor snapshots are stored.
#   "bundled" = the small in-cluster object store that Substrate's installer
#               deploys in its local-cluster profile (1Gi, fixed credentials).
#               Enough to see it work. Not for anything you want to keep.
#   "s3"      = an S3-compatible store you run (MinIO, Ceph RGW, ...).
SNAPSHOT_STORE="bundled"
# "true" = replace the bundled store's published login (rustfsadmin) with a
# generated login in a Secret, and disable its web console. Untested against
# Substrate's rustfs deployment.
BUNDLED_STORE_GENERATED_LOGIN="true"
S3_ENDPOINT_URL=""                  # for example https://s3.corp.example
S3_REGION="us-east-1"
S3_BUCKET=""                        # must already exist
S3_USE_PATH_STYLE="true"
# "true" = accept an http:// S3_ENDPOINT_URL (unencrypted snapshots).
S3_ALLOW_HTTP="false"
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: export them in your shell.

# key=value node label for Substrate's sandbox worker pods (for example
# "ate.dev/sandbox-nodes=true", paired with taint ate.dev/sandboxClass=gvisor:NoSchedule
# so Looker, the gateway and credential pods do not share nodes with sandboxes).
# Untested on a cluster.
WORKER_NODE_SELECTOR=""

# --- GKE only -----------------------------------------------------------------
GCP_REGION="us-central1"
GKE_CLUSTER_NAME="looker-agent"
GKE_CLUSTER_LOCATION="us-central1-a"
GKE_NETWORK="default"
GKE_SUBNETWORK="default"
GKE_MACHINE_TYPE="n2-standard-8"    # Looker and the agent's worker pod run here
# Two extra one-node pools that keep Substrate's control plane and its database
# off the nodes that run sandboxes. Substrate's installer recommends them.
GKE_SEPARATE_SYSTEM_NODES="true"

# --- Agent endpoint -----------------------------------------------------------
# The gateway knows two credentials. Leave a password unset to have one
# generated and stored in a Secret; the script prints how to read it.
#
# The administrator's opens everything the agent's server offers.
GATEWAY_BASIC_AUTH_USER="agent"
# GATEWAY_BASIC_AUTH_PASSWORD: export it to choose your own, 16 characters or more.
#
# The chat's can start and poll agent turns and fetch their artifacts, nothing
# else. It is the one stored in Looker for the extension, where every chat user
# can make use of it. Never put the administrator's there.
GATEWAY_CHAT_AUTH_USER="looker-chat"
# GATEWAY_CHAT_AUTH_PASSWORD: export it to choose your own, 16 characters or more.

# Private CA certificates inside the cluster:
#   "off"        = Looker serves its built-in self-signed cert and the gateway
#                  uses plain HTTP unless GATEWAY_TLS_SECRET is named below.
#   "private-ca" = openssl generates a private CA and certificates for Looker
#                  and the gateway; Looker builds a keystore and JDK truststore
#                  in an init container, the CA goes into the agent image, and
#                  LOOKER_VERIFY_SSL defaults to "true". Untested against Looker
#                  on a live cluster.
INTERNAL_TLS="off"

# A certificate for the gateway itself: the name of a kubernetes.io/tls Secret
# in GATEWAY_NAMESPACE. With it the gateway serves HTTPS, its Service moves to
# port 443, and the address Looker's server is given starts with https://.
# Without it the chat password crosses the cluster network unencrypted on every
# call. The certificate must name looker-agent-gateway.<GATEWAY_NAMESPACE>.svc.cluster.local,
# and Looker's server must trust its issuer (Looker uses Java's CA bundle).
GATEWAY_TLS_SECRET=""

# Optional Ingress for the gateway. Without it, reach the gateway with
# "kubectl port-forward" (the script prints the command). An Ingress needs its
# certificate: AGENT_TLS_SECRET is required with it. It publishes only what the
# chat needs; the agent's developer API stays on "kubectl port-forward".
AGENT_INGRESS_ENABLED="false"
AGENT_HOST=""
AGENT_INGRESS_CLASS="nginx"
AGENT_TLS_SECRET=""                 # kubernetes.io/tls Secret in GATEWAY_NAMESPACE

# Base image for agent/Dockerfile. Pin by @sha256: digest for SECURITY_MODE="strict".
AGENT_BASE_IMAGE="python:3.12-slim"
# --- Images of the kit's own pods -----------------------------------------------
# Named by tag here, which SECURITY_MODE="strict" refuses: a tag is whatever it
# points at on the day a node pulls it. To pin one, write it with its digest,
# name:tag@sha256:<digest> ("docker buildx imagetools inspect NAME" shows it).
GATEWAY_IMAGE="python:3.12-slim"
GATEWAY_MAX_CONNECTIONS="256"
GATEWAY_MAX_RUNNING_JOBS="32"
GATEWAY_MAX_CHAT_RUNNING_JOBS="24"
GATEWAY_JOB_DEADLINE_SECONDS="600"
TOKEN_REFRESHER_IMAGE="gcr.io/google.com/cloudsdktool/google-cloud-cli:slim"   # Vertex AI providers only
LOOKER_MYSQL_IMAGE="mysql:8.4"      # bundled MySQL only
BUSYBOX_IMAGE="busybox:1.36"        # LOOKER_CHOWN_SHARED_FILES only

# --- Chat inside Looker (the extension) ----------------------------------------
# People talk to the agent from a chat that runs inside Looker. Step 8 prepares
# it and "./deploy.sh extension" builds it; looker-extension/README.md has the
# details. An extension has no network access of its own, so its calls to the
# gateway go one of two ways:
#   "server"  Looker's server makes every call. Nothing but Looker has to reach
#             the gateway, which can stay inside the cluster. Simplest to set
#             up. Looker's documentation describes its server proxy as a way to
#             fetch access tokens, not as a general-purpose proxy.
#   "browser" Looker's server only trades the gateway password for a
#             short-lived token; the calls then go from the user's browser.
#             This is the pattern Looker documents. It needs the gateway on an
#             https address that browsers can reach and trust: set
#             AGENT_INGRESS_ENABLED, AGENT_HOST and AGENT_TLS_SECRET above.
EXTENSION_TRANSPORT="server"
# Where Looker's SERVER reaches the gateway (scheme://host[:port], no path).
# Empty: the gateway's in-cluster address when this script deploys Looker,
# otherwise https://AGENT_HOST.
EXTENSION_SERVER_GATEWAY_URL=""
# Where BROWSERS reach the gateway. "browser" transport only; https only.
# Empty: https://AGENT_HOST.
EXTENSION_BROWSER_GATEWAY_URL=""
# Sites whose pages may call the gateway from a browser, comma-separated
# (https://host[:port]). Empty: none for "server", your Looker for "browser".
GATEWAY_CORS_ALLOWED_ORIGINS=""
# The LookML project and application the extension is installed as. Looker
# looks the gateway credential up in a user attribute named
# <project>_<application>_gateway_credential.
EXTENSION_PROJECT_NAME="looker_agent"
EXTENSION_APPLICATION_NAME="chat"
# What people see in Looker's menu.
EXTENSION_LABEL="Looker Agent"
# Any existing Looker connection. Looker shows an extension to the users of a
# model in its project, and a model needs a connection; none is queried.
EXTENSION_LOOKML_CONNECTION=""
# "true" = the extension asks Looker for the right to save files, so that
# people can save a rendered chart by clicking it. Without it nothing an
# answer contains can be written to a user's disk.
EXTENSION_ALLOW_DOWNLOADS="false"
# Optional comma-separated https://host[:port] origins that links in chat
# answers may open (in addition to this Looker). Written to both deployment.js
# and manifest.lkml (new_window_external_urls).
EXTENSION_ALLOWED_LINK_ORIGINS=""
