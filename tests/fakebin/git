# Fake git. "fetch" notes which ref was asked for, and "rev-parse HEAD" then
# says which commit that is: a full commit id is itself; a tag is the commit
# in $FAKE_STATE/tag-commit (a test writes one there to play a moved tag), or
# else the commit deploy.sh expects of Substrate v1.0.0.
. "$(dirname "$0")/fake-common.sh"
fake_record git "$@"
dir="."
if [ "${1:-}" = "-C" ]; then dir="$2"; shift 2; fi
case "${1:-}" in
  init) mkdir -p "${@: -1}" ;;
  fetch) printf '%s' "${@: -1}" > "$dir/.fake-fetched-ref" ;;
  rev-parse)
    ref="$(cat "$dir/.fake-fetched-ref" 2>/dev/null || true)"
    if printf '%s' "$ref" | grep -Eq '^[0-9a-f]{40}$'; then
      echo "$ref"
    elif [ -e "$FAKE_STATE/tag-commit" ]; then
      cat "$FAKE_STATE/tag-commit"
    else
      echo "b34fbee742906494b5eb4f1f36987176bf8770a4"
    fi ;;
esac
exit 0
