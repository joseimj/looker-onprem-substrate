# Records jq arguments (to confirm secrets pass via env/stdin, not argv), then
# delegates to the real jq binary. Intentionally skips fake_check_environment
# because deploy.sh passes LOOKER_LICENSE_KEY via env to this one command.
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
{ printf 'jq'; printf ' %s' "$@"; echo; } >> "$FAKE_LOG"
real_jq=""
IFS=':' read -r -a path_dirs <<< "$PATH"
for d in "${path_dirs[@]}"; do
  [ "$d" = "$self_dir" ] && continue
  if [ -x "${d}/jq" ]; then real_jq="${d}/jq"; break; fi
done
[ -n "$real_jq" ] || { echo "fakebin/jq: real jq not found in PATH" >&2; exit 127; }
exec "$real_jq" "$@"
