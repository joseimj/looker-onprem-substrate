# The "kubectl ate" plugin, faked: atespaces, templates, actors, egress policies.
atespace=""; args=(); while [ $# -gt 0 ]; do case "$1" in -a) atespace="$2"; shift 2; continue ;; esac; args+=("$1"); shift; done
set -- "${args[@]}"
case "$1 $2" in
  "get atespace") [ -e "$FAKE_STATE/atespace-$3" ] ;;
  "create atespace") : > "$FAKE_STATE/atespace-$3" ;;
  "get actor-template") [ -e "$FAKE_STATE/template-$3" ] || exit 1
     case " $* " in *" -o json "*) echo '{"status":{"goldenSnapshotStatus":{"goldenTag":{"atespace":"x","name":"golden-tag-1"}}}}' ;; esac ;;
  "get actor-templates") # the list, as JSON
     printf '['; first=1
     for file in "$FAKE_STATE"/template-*; do
       [ -e "$file" ] || continue
       [ "$first" = 1 ] || printf ','; first=0
       printf '{"metadata":{"atespace":"%s","name":"%s"}}' "$atespace" "${file##*/template-}"
     done
     printf ']\n' ;;
  "create actor-template") name="$(awk '/^  name:/{print $2; exit}' "$4")"; cp "$4" "$FAKE_STATE/template-$name"; echo "template $name created" ;;
  "delete actor-template") [ -e "$FAKE_STATE/template-$3" ] || exit 1
     rm -f "$FAKE_STATE/template-$3" ;;
  "get actor") [ -e "$FAKE_STATE/actor-$3" ] || exit 1
     case " $* " in *" -o json "*) printf '{"actorTemplate":{"name":"%s"},"status":{"state":"ACTOR_STATE_RUNNING"}}\n' "$(cat "$FAKE_STATE/actor-$3")" ;; esac ;;
  "create actor") printf '%s' "${4#--template=}" > "$FAKE_STATE/actor-$3" ;;
  "update actor") printf '%s' "${4#--template=}" > "$FAKE_STATE/actor-$3" ;;
  "get egress-policy")
     if [ -e "$FAKE_STATE/egress-$3" ]; then
       case " $* " in *" -o json "*) printf '{"metadata":{"atespace":"%s","name":"default","uid":"egress-uid-1","version":"1"}}\n' "$atespace" ;; esac
     fi ;;
  "update egress-policy") [ -e "$FAKE_STATE/egress-$3" ] || exit 1
     grep -q '^  uid:' "$5" && grep -q '^  version:' "$5" || { echo "missing uid/version preconditions" >&2; exit 1; }
     cp "$5" "$FAKE_STATE/egress-$3" ;;
  "delete egress-policy") [ -e "$FAKE_STATE/egress-$3" ] && rm -f "$FAKE_STATE/egress-$3" ;;
  "create egress-policy") cp "$5" "$FAKE_STATE/egress-$3" ;;
  *) exit 0 ;;
esac
