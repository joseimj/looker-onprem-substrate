. "$(dirname "$0")/fake-common.sh"
fake_record docker "$@"
case "$1" in
  info) exit 0 ;;
  inspect) ref="${@: -1}"; repo="${ref%:*}"; echo "${repo}@sha256:$(printf '%s' "$ref" | sha256sum | cut -d ' ' -f 1)" ;;
  build) ctx="${@: -1}"; [ -f "$ctx/Dockerfile" ] || { echo "no Dockerfile in $ctx" >&2; exit 1; }
         ls "$ctx" > "$FAKE_STATE/build-context-$(basename "$ctx").txt"
         if [ -f "$ctx/extra-ca.pem" ]; then cp "$ctx/extra-ca.pem" "$FAKE_STATE/extra-ca-$(basename "$ctx").pem"; fi ;;
  *) exit 0 ;;
esac
