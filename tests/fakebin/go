. "$(dirname "$0")/fake-common.sh"
fake_record go "$@"
case "$*" in
  version) echo "go version go1.27.4 linux/amd64" ;;
  "build -o "*) printf '#!/bin/sh\nexit 0\n' > "$3"; chmod +x "$3" ;;
  "run ./cmd/ate-setup "*)
    { echo "ARGS: $*"; echo "CWD: $PWD"; for v in PROJECT_ID CLUSTER_NAME CLUSTER_LOCATION BUCKET_NAME SNAPSHOT_LOCATION SNAPSHOT_TRANSFER_GSA_NAME ATE_RECORD_DIR; do echo "ENV $v=${!v-<unset>}"; done; } >> "$FAKE_STATE/ate-setup.log"
    : > "$FAKE_STATE/deployment-ate-system-ate-controller" ;;
  "-C tools/setup-gcp run . bootstrap")
    { echo "CWD: $PWD"; for v in PROJECT_ID PROJECT_NUMBER CLUSTER_NAME CLUSTER_LOCATION CLUSTER_VERSION RELEASE_CHANNEL NODE_MACHINE_TYPE ENABLE_NESTED_VIRTUALIZATION SEPARATE_SYSTEM_NODES BUCKET_NAME SNAPSHOT_LOCATION SNAPSHOT_TRANSFER_GSA_NAME; do echo "ENV $v=${!v-<unset>}"; done; } >> "$FAKE_STATE/setup-gcp.log" ;;
esac
