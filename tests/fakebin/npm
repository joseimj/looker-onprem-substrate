# Fake npm. Records each call with the directory it ran in. "run build" writes
# a bundle that holds the settings it was built with, so a test can tell which
# configuration ended up in it. Marker files in $FAKE_STATE make a step fail.
. "$(dirname "$0")/fake-common.sh"
{ printf 'npm'; printf ' %s' "$@"; printf ' [in %s]\n' "$(basename "$PWD")"; } >> "$FAKE_LOG"
fake_check_environment npm
case "$1 ${2:-}" in
  "install "*|"ci "*)
    if [ -e "$FAKE_STATE/npm-install-fails" ]; then echo "npm error network unreachable" >&2; exit 1; fi
    [ -f package.json ] || { echo "npm error no package.json in $PWD" >&2; exit 1; }
    [ "$1" = "ci" ] || echo '{"lockfileVersion": 3}' > package-lock.json ;;
  "test "*)
    if [ -e "$FAKE_STATE/npm-test-fails" ]; then echo "fail 1" >&2; exit 1; fi ;;
  "run build")
    if [ -e "$FAKE_STATE/npm-build-writes-nothing" ]; then exit 0; fi
    mkdir -p dist; { echo "// fake bundle"; cat src/deployment.js; } > dist/bundle.js ;;
  *) exit 0 ;;
esac
